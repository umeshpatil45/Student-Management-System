#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for Linux/macOS
# ----------------------------------------------------------------------------

WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$WRAPPER_DIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    mkdir -p "$WRAPPER_DIR/.mvn/wrapper"
    curl -o "$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
fi

exec java -Dmaven.multiModuleProjectDirectory="$WRAPPER_DIR" -cp "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
